#!/usr/bin/env perl
# Restored from upstream Verilator 4.x (missing in the RTLflow fork's bin/).
require 5.005;
use warnings;
print "// DESCRIPTION: Generated by verilator_includer via makefile\n";
foreach my $param (@ARGV) {
    if ($param =~ /^-D([^=]+)=(.*)/) {
        print "#define $1 $2\n";
    } else {
        print "#include \"$param\"\n";
    }
}
